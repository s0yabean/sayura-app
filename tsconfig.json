{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "useUnknownInCatchVariables": false,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "site",
    "tests",
    "vitest.config.ts"
  ]
}
