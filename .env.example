# Copy to .env and fill in your own values. Never commit .env.

# =====================================================================
# SERVER-ONLY SECRETS
# Read by the Expo Router API routes (app/**/+api.ts) via process.env.
# They are NOT listed in app.config.js `extra`, so they never ship in the app.
# =====================================================================

# Speech-to-text (proxied by app/assemblyai/[...path]+api.ts)
ASSEMBLYAI_API_KEY=

# LLM orchestrator: Groq primary, Azure OpenAI fallback
GROQ_ENABLED=true
GROQ_API_KEY=
LLM_TIMEOUT_MS=2000
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# =====================================================================
# PUBLIC CLIENT CONFIG (bundled into the app by design)
# =====================================================================

# Where the app finds the API routes. In dev: your Metro server, e.g. http://192.168.1.20:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:8081

# App identity (placeholders)
APP_BUNDLE_ID=com.example.sayura
EXPO_OWNER=
EAS_PROJECT_ID=

# RevenueCat public SDK key (appl_... / goog_...); safe to ship, not a secret key
REVENUE_CAT_PUBLIC_SDK_KEY=

# Firebase web config (public identifiers; access is enforced by firestore.rules)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist

# Google / Apple sign-in (OAuth client IDs are public)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_IOS_CLIENT_ID

# Dev-only fallback login (optional)
EXPO_PUBLIC_DEV_TEST_EMAIL=
EXPO_PUBLIC_DEV_TEST_PASSWORD=
