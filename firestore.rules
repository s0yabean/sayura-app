rules_version = '2';

// Sayura stores everything under users/{uid}: the profile doc plus an
// `affirmations` subcollection. Each signed-in user (including anonymous
// Firebase Auth users) can read and write only their own subtree.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /affirmations/{affirmationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
